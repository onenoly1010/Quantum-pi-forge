  "forbiddenPaths": [
    "contracts/**",
    "wallets/**",
    "src/**",
    "package.json",
    "package-lock.json",
    "functions/**",
    "qpf-core/**"
  ],
  "forbiddenActions": [
    "protocol token mint",
