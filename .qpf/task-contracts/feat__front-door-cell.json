{
  "schema": "qpf.task_contract.v1",
  "branch": "feat/front-door-cell",
  "outcome": "Put one bounded co-creator at the public door: constitution, propose, STOP, receipt. Not a token mint, wallet, or arena.",
  "canonicalSources": [
    "deploy/meet.html",
    "deploy/meet.js",
    "deploy/front-door-cell.json"
  ],
  "allowedPaths": [
    ".qpf/task-contracts/feat__front-door-cell.json",
    "deploy/meet.html",
    "deploy/meet.js",
    "deploy/front-door-cell.json",
    "deploy/index.html",
    "deploy/sitemap.xml",
    "scripts/build.js",
    "scripts/verify-entry-surfaces.cjs",
    "scripts/verify-front-door-cell.cjs"
  ],
  "forbiddenPaths": [
    "contracts/**",
    "wallets/**",
    "src/**",
    "package.json",
    "package-lock.json"
  ],
  "forbiddenActions": [
    "public mint",
    "liquidity",
    "staking/yield",
    "wallet transfer",
    "storing visitor messages",
