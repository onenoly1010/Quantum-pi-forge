    "test -f out/meet.html",
    "grep -q 'Meet a co-creator' out/meet.html",
    "grep -q '/meet.html' out/index.html",
    "grep -q 'Know what is real' out/index.html",
    "npm run verify:entry-surfaces"
  ],
  "definitionOfDone": [
    "/meet is a bounded participant with STOP on mint/wallet.",
    "Homepage still says Know what is real and protocol mint is not authorized.",
    "No token, wallet, or visitor-data store."
  ],
  "authorizationRequired": [
    "activating mint, staking, LP, or bridge"
  ]
}
