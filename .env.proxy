# LiteLLM Proxy Environment Variables
# OINIO Quantum Forge
# Save this file and load with: source .env.proxy

# Model API Keys - Add your keys here
ANTHROPIC_API_KEY=sk-ant-
OPENAI_API_KEY=sk-
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# LiteLLM Configuration
LITELLM_LOG=INFO
LITELLM_CACHE=redis
LITELLM_DISABLE_TELEMETRY=true
LITELLM_SKIP_DEPENDENCY_CHECK=true

# MCP Bridge Configuration
MCP_ENABLED=true
MCP_SERVER_ADDRESS=http://localhost:3000