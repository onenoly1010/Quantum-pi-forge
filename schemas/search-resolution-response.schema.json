{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchResolutionResponse",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "enum": ["json", "markdown"]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "snippet": {
            "type": "string"
          }
        },
        "required": ["topic", "score"]
      }
    }
  },
  "required": ["query", "format", "results"]
}
