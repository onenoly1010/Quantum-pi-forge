# Quantum Pi Forge Press Agent Configuration

# Server Configuration
PRESS_AGENT_PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Revenue delivery foundation: disabled by default. Never commit the local .env file.
OUTREACH_DELIVERY_MODE=disabled
OUTREACH_EVIDENCE_DIR=../../receipts/outreach/delivery
# Required, in addition to live mode, before a future live adapter may send.
OUTREACH_LIVE_SEND_ACK=

# Public X posts only. Private outreach requires a separate, provider-supported adapter.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
PRESS_AGENT_LIVE_X_POST=

# Future email adapter configuration.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Future per-provider contact-form adapter configuration.
CONTACT_FORM_PROVIDER=
CONTACT_FORM_ENDPOINT=
CONTACT_FORM_API_KEY=

# WordPress CMS Integration (optional)
WORDPRESS_SITE_URL=https://your-wordpress-site.com
WORDPRESS_USERNAME=your-username
WORDPRESS_APP_PASSWORD=your-application-password

# Note: For WordPress, you need to create an Application Password
# Go to WordPress Admin > Users > Your Profile > Application Passwords
