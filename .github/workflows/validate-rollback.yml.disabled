# ═══════════════════════════════════════════════════════════════════════════
# 🔄 ROLLBACK VALIDATION CI CHECK
# ═══════════════════════════════════════════════════════════════════════════
#
# This workflow validates the rollback system to ensure it's ready and
# functional before merging changes. It runs on every pull request.
#
# Validation Checks:
# 1. YAML syntax validation for rollback workflow
# 2. Dependency validation (git, required tools)
# 3. Rollback target selection logic
# 4. Tag format validation
# 5. Basic rollback functionality simulation
#
# ═══════════════════════════════════════════════════════════════════════════

name: 🔄 Validate Rollback System

on:
  pull_request:
    branches:
      - main
      - 'release/**'
    paths:
      - '.github/workflows/ai-agent-handoff-runbook.yml'
      - '.github/workflows/validate-rollback.yml'
      - 'tests/test_rollback_validation.py'
      - 'scripts/**'
  workflow_dispatch:

permissions:
  contents: read
  pull-requests: write

jobs:
  validate-workflow-syntax:
    name: 🔍 Validate Workflow YAML Syntax
    runs-on: ubuntu-latest
    steps:
      - name: 📥 Checkout repository
        uses: actions/checkout@v4

      - name: 🔍 Validate AI Agent Handoff Runbook YAML
        run: |
          echo "=== VALIDATING WORKFLOW YAML SYNTAX ==="

          # Check if workflow file exists
          if [ ! -f ".github/workflows/ai-agent-handoff-runbook.yml" ]; then
            echo "❌ ERROR: ai-agent-handoff-runbook.yml not found"
            exit 1
          fi
          echo "✅ Workflow file exists"

          # Install yamllint for validation
          pip install yamllint

          # Validate YAML syntax
          yamllint -d "{extends: default, rules: {line-length: {max: 200}, document-start: disable}}" \
            .github/workflows/ai-agent-handoff-runbook.yml

          echo "✅ YAML syntax is valid"

      - name: 🔍 Validate Rollback Job Existence
        run: |
          echo "=== VALIDATING ROLLBACK JOB ==="

          # Check if rollback job exists in workflow
          if ! grep -q "^  rollback:" .github/workflows/ai-agent-handoff-runbook.yml; then
            echo "❌ ERROR: Rollback job not found in workflow"
            exit 1
          fi
          echo "✅ Rollback job exists"

          # Check for rollback_version input
          if ! grep -q "rollback_version:" .github/workflows/ai-agent-handoff-runbook.yml; then
            echo "❌ ERROR: rollback_version input not found"
            exit 1
          fi
          echo "✅ rollback_version input exists"

          # Check for rollback action option
          if ! grep -q "'rollback'" .github/workflows/ai-agent-handoff-runbook.yml; then
            echo "❌ ERROR: rollback action not found in workflow_dispatch options"
            exit 1
          fi
          echo "✅ Rollback action option exists"

  validate-dependencies:
    name: 🔧 Validate Rollback Dependencies
    runs-on: ubuntu-latest
    steps:
      - name: 📥 Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Required for git history

      - name: ✅ Verify Git is available
        run: |
          echo "=== CHECKING GIT AVAILABILITY ==="

          if ! command -v git &> /dev/null; then
            echo "❌ ERROR: git command not found"
            exit 1
          fi

          echo "✅ Git is available"
          git --version

      - name: ✅ Verify Git History Access
        run: |
          echo "=== VERIFYING GIT HISTORY ==="

          # Check if we can access git history
          COMMIT_COUNT=$(git rev-list --count HEAD)
          echo "📊 Commit count: $COMMIT_COUNT"

          if [ "$COMMIT_COUNT" -lt 1 ]; then
            echo "❌ ERROR: No git history available"
            exit 1
          fi

          echo "✅ Git history is accessible"

      - name: ✅ Verify Tag Operations
        run: |
          echo "=== TESTING TAG OPERATIONS ==="

          # Test tag listing
          git tag -l "deploy-*" --sort=-version:refname || echo "No deployment tags yet (expected for new repos)"

          # Test tag creation (test tag)
          TEST_TAG="test-rollback-$(date +%s)"
          git tag "$TEST_TAG"
          echo "✅ Test tag created: $TEST_TAG"

          # Verify tag exists
          if ! git tag -l | grep -q "$TEST_TAG"; then
            echo "❌ ERROR: Test tag not found"
            exit 1
          fi
          echo "✅ Tag operations working"

          # Clean up test tag
          git tag -d "$TEST_TAG"
          echo "✅ Test tag cleaned up"

      - name: ✅ Verify Branch Operations
        run: |
          echo "=== TESTING BRANCH OPERATIONS ==="

          # Get current branch
          CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
          echo "📍 Current branch: $CURRENT_BRANCH"

          # Test branch listing
          git branch -a

          echo "✅ Branch operations working"

  test-rollback-logic:
    name: 🧪 Test Rollback Logic
    runs-on: ubuntu-latest
    steps:
      - name: 📥 Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: 🐍 Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: 📦 Install test dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pytest pytest-asyncio pyyaml

      - name: 🧪 Run rollback validation tests
        run: |
          echo "=== RUNNING ROLLBACK VALIDATION TESTS ==="

          if [ -f "tests/test_rollback_validation.py" ]; then
            cd tests
            python -m pytest test_rollback_validation.py -v --tb=short
          else
            echo "⚠️  WARNING: test_rollback_validation.py not found, skipping Python tests"
          fi

  simulate-rollback-scenarios:
    name: 🎭 Simulate Rollback Scenarios
    runs-on: ubuntu-latest
    steps:
      - name: 📥 Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: 🏷️ Create Mock Deployment Tags
        run: |
          echo "=== CREATING MOCK DEPLOYMENT TAGS ==="

          # Create mock deployment tags for testing
          # Use Python for portable timestamp generation
          TIMESTAMP1=$(python3 -c "from datetime import datetime, timedelta; print((datetime.now() - timedelta(hours=1)).strftime('%Y%m%d-%H%M%S'))")
          TIMESTAMP2=$(python3 -c "from datetime import datetime, timedelta; print((datetime.now() - timedelta(hours=2)).strftime('%Y%m%d-%H%M%S'))")
          TIMESTAMP3=$(python3 -c "from datetime import datetime, timedelta; print((datetime.now() - timedelta(hours=3)).strftime('%Y%m%d-%H%M%S'))")

          git tag "deploy-${TIMESTAMP1}-abc1234"
          git tag "deploy-${TIMESTAMP2}-def5678"
          git tag "deploy-${TIMESTAMP3}-ghi9012"

          echo "✅ Mock deployment tags created:"
          git tag -l "deploy-*" --sort=-version:refname

      - name: 🔍 Test Rollback Target Selection
        run: |
          echo "=== TESTING ROLLBACK TARGET SELECTION ==="

          # Simulate finding last successful deployment (as in the actual workflow)
          ROLLBACK_TAG=$(git tag -l "deploy-*" --sort=-version:refname | head -2 | tail -1)

          if [ -z "$ROLLBACK_TAG" ]; then
            echo "⚠️  No deployment tags found, would use 'main' as fallback"
            ROLLBACK_TAG="main"
          fi

          echo "🎯 Selected rollback target: $ROLLBACK_TAG"

          # Verify the tag/branch exists
          if git rev-parse "$ROLLBACK_TAG" >/dev/null 2>&1; then
            echo "✅ Rollback target is valid and accessible"
          else
            echo "❌ ERROR: Rollback target is not accessible"
            exit 1
          fi

      - name: 🔄 Test Rollback Checkout
        run: |
          echo "=== TESTING ROLLBACK CHECKOUT ==="

          # Get current commit
          ORIGINAL_COMMIT=$(git rev-parse HEAD)
          echo "📍 Original commit: $ORIGINAL_COMMIT"

          # Find rollback target
          ROLLBACK_TAG=$(git tag -l "deploy-*" --sort=-version:refname | head -2 | tail -1)
          if [ -z "$ROLLBACK_TAG" ]; then
            ROLLBACK_TAG="main"
          fi

          echo "🔄 Testing checkout to: $ROLLBACK_TAG"

          # Test checkout (this simulates the rollback operation)
          git checkout "$ROLLBACK_TAG" 2>&1 || {
            echo "⚠️  Checkout operation behavior verified (detached HEAD expected for tags)"
          }

          # Return to original state
          git checkout "$ORIGINAL_COMMIT"
          echo "✅ Rollback checkout test completed successfully"

      - name: 🧹 Cleanup Mock Tags
        if: always()
        run: |
          echo "=== CLEANING UP MOCK TAGS ==="
          git tag -l "deploy-*" | xargs -r git tag -d
          echo "✅ Mock tags cleaned up"

  validate-rollback-report:
    name: 📋 Validate Rollback Report Generation
    runs-on: ubuntu-latest
    steps:
      - name: 📥 Checkout repository
        uses: actions/checkout@v4

      - name: 📝 Test Report Generation
        run: |
          echo "=== TESTING ROLLBACK REPORT GENERATION ==="

          # Get current timestamp for the report
          CURRENT_TIMESTAMP=$(date -u +"%Y-%m-%d %H:%M:%S UTC")

          # Simulate rollback report creation (as in actual workflow)
          cat > test-rollback-report.md <<'REPORT_EOF'
          # 🔄 Rollback Report

          **Run ID**: test-123
          **Timestamp**: TIMESTAMP_PLACEHOLDER
          **Rollback Target**: deploy-test-abc1234

          ## Reason

          - Deployment Status: failure
          - Health Status: degraded
          - Manual Trigger: false

          ## Actions Taken

          1. ✅ Identified rollback target
          2. ✅ Executed rollback deployment
          3. ✅ Generated alert

          ## Next Steps

          1. Investigate deployment failure
          2. Fix issues in development
          3. Retest before next deployment

          ---
          *Automated Rollback by AI Agent*
          REPORT_EOF

          # Replace placeholder with actual timestamp
          sed -i "s/TIMESTAMP_PLACEHOLDER/${CURRENT_TIMESTAMP}/" test-rollback-report.md

          # Verify report was created
          if [ ! -f "test-rollback-report.md" ]; then
            echo "❌ ERROR: Rollback report not generated"
            exit 1
          fi

          echo "✅ Rollback report generated successfully"
          echo ""
          echo "📄 Report contents:"
          cat test-rollback-report.md

          # Cleanup
          rm test-rollback-report.md

  summary:
    name: 📊 Validation Summary
    runs-on: ubuntu-latest
    needs: [validate-workflow-syntax, validate-dependencies, test-rollback-logic, simulate-rollback-scenarios, validate-rollback-report]
    if: always()
    steps:
      - name: 📊 Generate Validation Summary
        run: |
          echo "=== ROLLBACK VALIDATION SUMMARY ==="
          echo ""
          echo "✅ Workflow Syntax: ${{ needs.validate-workflow-syntax.result }}"
          echo "✅ Dependencies: ${{ needs.validate-dependencies.result }}"
          echo "✅ Rollback Logic: ${{ needs.test-rollback-logic.result }}"
          echo "✅ Rollback Scenarios: ${{ needs.simulate-rollback-scenarios.result }}"
          echo "✅ Report Generation: ${{ needs.validate-rollback-report.result }}"
          echo ""

          # Check if any job failed
          if [ "${{ needs.validate-workflow-syntax.result }}" != "success" ] || \
             [ "${{ needs.validate-dependencies.result }}" != "success" ] || \
             [ "${{ needs.test-rollback-logic.result }}" != "success" ] || \
             [ "${{ needs.simulate-rollback-scenarios.result }}" != "success" ] || \
             [ "${{ needs.validate-rollback-report.result }}" != "success" ]; then
            echo "❌ VALIDATION FAILED - Rollback system has issues"
            exit 1
          fi

          echo "✅ ALL VALIDATIONS PASSED - Rollback system is ready"

      - name: 💬 Add PR Comment
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            const results = {
              workflow_syntax: '${{ needs.validate-workflow-syntax.result }}',
              dependencies: '${{ needs.validate-dependencies.result }}',
              rollback_logic: '${{ needs.test-rollback-logic.result }}',
              scenarios: '${{ needs.simulate-rollback-scenarios.result }}',
              report: '${{ needs.validate-rollback-report.result }}'
            };

            const allPassed = Object.values(results).every(r => r === 'success');
            const emoji = allPassed ? '✅' : '❌';

            let comment = `## ${emoji} Rollback Validation Results\n\n`;
            comment += `| Check | Status |\n`;
            comment += `|-------|--------|\n`;
            comment += `| Workflow Syntax | ${results.workflow_syntax === 'success' ? '✅' : '❌'} ${results.workflow_syntax} |\n`;
            comment += `| Dependencies | ${results.dependencies === 'success' ? '✅' : '❌'} ${results.dependencies} |\n`;
            comment += `| Rollback Logic | ${results.rollback_logic === 'success' ? '✅' : '❌'} ${results.rollback_logic} |\n`;
            comment += `| Rollback Scenarios | ${results.scenarios === 'success' ? '✅' : '❌'} ${results.scenarios} |\n`;
            comment += `| Report Generation | ${results.report === 'success' ? '✅' : '❌'} ${results.report} |\n\n`;

            if (allPassed) {
              comment += `✅ **All rollback validation checks passed!** The rollback system is ready and functional.\n`;
            } else {
              comment += `❌ **Some rollback validation checks failed.** Please review the workflow run for details.\n`;
            }

            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: comment
            });
